{
  "about": "Parity suite for the post rubric (playbook/rubrics/post.json). Each case patches post-pass.json (and optionally factsheet.json) and lists the EXACT set of deterministic check ids that must fail. Kapyn's TS engine (scripts/validate-blog-post.ts --self-test) and HERMES's Python engine must both agree. Patch ops: RFC 6902 add/replace/remove on JSON Pointers, plus edit (replace the first occurrence of find in the string at path; it must exist). Fixture content is fictional (Example Labs, example.com).",
  "factsheet": "factsheet.json",
  "base": "post-pass.json",
  "existing_slugs": ["ai-stack-for-indie-hackers-2026"],
  "cases": [
    { "name": "pass", "fail": [] },
    { "name": "extra top-level key", "fail": ["schema"],
      "patch": [{ "op": "add", "path": "/extra", "value": 1 }] },
    { "name": "too short", "fail": ["word_count"],
      "patch": [{ "op": "remove", "path": "/body/11" }, { "op": "remove", "path": "/body/7" },
                { "op": "remove", "path": "/body/4" }, { "op": "remove", "path": "/body/3" }] },
    { "name": "every block cites one fact", "fail": ["words_per_fact"],
      "patch": [{ "op": "replace", "path": "/body/0/facts", "value": ["f1"] }, { "op": "replace", "path": "/body/1/facts", "value": ["f1"] },
                { "op": "replace", "path": "/body/3/facts", "value": ["f1"] }, { "op": "replace", "path": "/body/4/facts", "value": ["f1"] },
                { "op": "replace", "path": "/body/6/facts", "value": ["f1"] }, { "op": "replace", "path": "/body/7/facts", "value": ["f1"] },
                { "op": "replace", "path": "/body/8/facts", "value": ["f1"] }, { "op": "replace", "path": "/body/10/facts", "value": ["f1"] },
                { "op": "replace", "path": "/body/11/facts", "value": ["f1"] }] },
    { "name": "em dash", "fail": ["em_dash"],
      "patch": [{ "op": "edit", "path": "/body/3/text", "find": "at once, and", "replace": "at once — and" }] },
    { "name": "dash residue", "fail": ["dash_residue"],
      "patch": [{ "op": "edit", "path": "/body/4/text", "find": "output side. The", "replace": "output side , the" }] },
    { "name": "exclamation in deck", "fail": ["exclamation"],
      "patch": [{ "op": "edit", "path": "/deck", "find": "outside tests.", "replace": "outside tests!" }] },
    { "name": "emoji", "fail": ["emoji"],
      "patch": [{ "op": "edit", "path": "/body/4/text", "find": "assuming a saving", "replace": "assuming a saving 🚀" }] },
    { "name": "hype word", "fail": ["hype"],
      "patch": [{ "op": "edit", "path": "/body/3/text", "find": "they compound", "replace": "the result is groundbreaking" }] },
    { "name": "filler phrase", "fail": ["filler"],
      "patch": [{ "op": "edit", "path": "/body/4/text", "find": "What the launch", "replace": "It is worth noting that what the launch" }] },
    { "name": "paragraph refers to the post", "fail": ["self_reference"],
      "patch": [{ "op": "edit", "path": "/body/4/text", "find": "What the launch", "replace": "This post looks at what the launch" }] },
    { "name": "number not in the fact sheet", "fail": ["numbers_grounded"],
      "patch": [{ "op": "edit", "path": "/body/1/text", "find": "400,000 tokens", "replace": "500,000 tokens" }] },
    { "name": "link outside the fact sheet", "fail": ["urls_grounded"],
      "patch": [{ "op": "edit", "path": "/body/6/text", "find": "https://example.org/cloud/model-q-2-regions", "replace": "https://example.org/cloud/pricing" }] },
    { "name": "unknown fact id", "fail": ["fact_refs_valid"],
      "patch": [{ "op": "replace", "path": "/body/3/facts", "value": ["f2", "f99"] }] },
    { "name": "numeric block without facts", "fail": ["numeric_blocks_cite"],
      "patch": [{ "op": "remove", "path": "/body/1/facts" }] },
    { "name": "one source only", "fail": ["min_sources"],
      "factsheet_patch": [{ "op": "replace", "path": "/sources/1/source_name", "value": "Example Labs" },
                          { "op": "replace", "path": "/sources/2/source_name", "value": "Example Labs" }] },
    { "name": "cited source missing from Sources", "fail": ["sources_section"],
      "patch": [{ "op": "remove", "path": "/body/13/items/2" }] },
    { "name": "no lead flag", "fail": ["lead_first"],
      "patch": [{ "op": "remove", "path": "/body/0/lead" }] },
    { "name": "two headings", "fail": ["headings"],
      "patch": [{ "op": "remove", "path": "/body/9" }, { "op": "remove", "path": "/body/5" }] },
    { "name": "question title", "fail": ["title_no_question"],
      "patch": [{ "op": "replace", "path": "/title", "value": "Is Model Q 2 worth the switch?" }] },
    { "name": "slug taken", "fail": ["slug_unique"],
      "existing_slugs": ["model-q-2-input-price-cut"] }
  ]
}
