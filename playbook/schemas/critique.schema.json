{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kapyn blog critique",
  "type": "object",
  "properties": {
    "scores": {
      "type": "object",
      "properties": {
        "grounding": { "type": "integer", "minimum": 1, "maximum": 5 },
        "synthesis": { "type": "integer", "minimum": 1, "maximum": 5 },
        "voice": { "type": "integer", "minimum": 1, "maximum": 5 },
        "value": { "type": "integer", "minimum": 1, "maximum": 5 },
        "structure": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "required": ["grounding", "synthesis", "voice", "value", "structure"],
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": { "type": "string", "enum": ["grounding", "synthesis", "voice", "value", "structure"] },
          "blocking": { "type": "boolean" },
          "quote": { "type": "string" },
          "action": { "type": "string", "enum": ["cut", "soften", "rewrite"] },
          "fix": { "type": "string" }
        },
        "required": ["criterion", "blocking", "quote", "action", "fix"],
        "additionalProperties": false
      }
    },
    "verdict": { "type": "string", "enum": ["pass", "revise", "reject"] }
  },
  "required": ["scores", "issues", "verdict"],
  "additionalProperties": false
}
