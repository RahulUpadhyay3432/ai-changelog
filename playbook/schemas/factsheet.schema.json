{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kapyn blog fact sheet",
  "type": "object",
  "properties": {
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^f[0-9]+$" },
          "text": { "type": "string" },
          "kind": { "type": "string", "enum": ["fact", "context"] },
          "certainty": { "type": "string", "enum": ["confirmed", "reported", "planned"] },
          "source_url": { "type": "string" },
          "source_name": { "type": "string" },
          "published_at": { "type": "string" }
        },
        "required": ["id", "text", "kind"],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_ids": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        },
        "required": ["fact_ids", "note"],
        "additionalProperties": false
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "source_name": { "type": "string" },
          "title": { "type": "string" }
        },
        "required": ["url", "source_name", "title"],
        "additionalProperties": false
      }
    }
  },
  "required": ["facts", "conflicts", "open_questions", "sources"],
  "additionalProperties": false
}
